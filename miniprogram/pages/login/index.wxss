.login-page {
  padding-top: 160rpx;
}

.hero-card {
  padding: 48rpx 32rpx;
  background: linear-gradient(135deg, #2f855a, #68d391);
  color: #ffffff;
}

.hero-card .muted {
  color: #e6fffa;
}

.role-item {
  border: 1rpx solid #cbd5e0;
  border-radius: 12rpx;
  padding: 22rpx;
  margin-top: 16rpx;
}

.role-active {
  border-color: #2f855a;
  background: #e6fffa;
  color: #276749;
}
