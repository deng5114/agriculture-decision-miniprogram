.year-row {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
}

.year-input { flex: 1; }
.year-separator { padding: 0 16rpx; color: #718096; }
.note { display: block; margin-top: 14rpx; line-height: 1.55; }
.source-card { border-left: 8rpx solid #68d391; }
.source-tag { color: #276749; font-weight: 700; }

.section-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.section-title { display: block; font-size: 32rpx; font-weight: 700; }
.chart-unit, .period { display: block; margin-top: 8rpx; color: #718096; font-size: 22rpx; }
.metric-tabs { display: flex; padding: 6rpx; border-radius: 12rpx; background: #edf2f7; }
.metric-tab { padding: 8rpx 14rpx; border-radius: 9rpx; color: #718096; font-size: 23rpx; }
.metric-tab.active { color: #276749; background: #ffffff; box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08); }
.trend-canvas { width: 100%; height: 380rpx; margin-top: 20rpx; }

.analysis-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; margin-top: 24rpx; }
.analysis-item { padding: 20rpx; border-radius: 14rpx; background: #f7fafc; }
.analysis-label { display: block; color: #718096; font-size: 23rpx; }
.analysis-value { display: block; margin-top: 8rpx; font-weight: 700; }
.range-line { display: block; margin-top: 20rpx; }
.methodology { display: block; margin-top: 18rpx; padding-top: 18rpx; border-top: 1rpx solid #e2e8f0; color: #718096; font-size: 23rpx; line-height: 1.6; }

.market-head { display: flex; justify-content: space-between; align-items: center; }
.crop-name { font-size: 34rpx; font-weight: 700; }
.price { color: #2f855a; font-size: 32rpx; font-weight: 700; }
.change-row { display: flex; margin: 22rpx 0 8rpx; padding: 18rpx 0; border-top: 1rpx solid #edf2f7; border-bottom: 1rpx solid #edf2f7; }
.change-item { flex: 1; text-align: center; font-weight: 700; }
.change-label { display: block; margin-bottom: 7rpx; color: #718096; font-size: 22rpx; font-weight: 400; }
.change-up { color: #c53030; }
.change-down { color: #2b6cb0; }
.change-flat { color: #718096; }
.market-line, .market-source { display: block; margin-top: 12rpx; }
.market-source { color: #718096; font-size: 24rpx; }
.empty-card { text-align: center; padding: 54rpx 28rpx; }
.empty-icon { display: block; margin-bottom: 12rpx; color: #a0aec0; font-size: 52rpx; }
