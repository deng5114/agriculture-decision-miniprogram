.welcome-card { background: linear-gradient(135deg, #f0fff4, #e6fffa); }
.loading-card { text-align: center; padding: 56rpx 28rpx; }

.summary-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.summary-card {
  padding: 28rpx 22rpx;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 6rpx 20rpx rgba(47, 133, 90, 0.08);
}

.summary-value { display: block; color: #276749; font-size: 40rpx; font-weight: 700; }
.budget-value { font-size: 32rpx; }
.summary-label { display: block; margin-top: 8rpx; color: #718096; font-size: 23rpx; }
.definition-card { border-left: 8rpx solid #f6ad55; background: #fffaf0; }
.definition-title { display: block; color: #9c4221; font-weight: 700; }
.definition-text, .definition-extra { display: block; margin-top: 10rpx; color: #744210; font-size: 24rpx; line-height: 1.6; }

.chart-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 18rpx; margin-bottom: 26rpx; }
.section-title { display: block; font-size: 30rpx; font-weight: 700; }
.chart-note { display: block; margin-top: 7rpx; color: #718096; font-size: 22rpx; }
.metric-tabs { display: flex; padding: 6rpx; border-radius: 12rpx; background: #edf2f7; }
.metric-tab { padding: 8rpx 18rpx; border-radius: 9rpx; color: #718096; font-size: 23rpx; }
.metric-tab.active { color: #276749; background: #ffffff; box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08); }

.bar-item { margin-top: 22rpx; }
.bar-label-row { display: flex; justify-content: space-between; margin-bottom: 9rpx; }
.bar-label { font-weight: 600; }
.bar-value { color: #4a5568; font-size: 24rpx; }
.bar-track { height: 20rpx; overflow: hidden; border-radius: 999rpx; background: #edf2f7; }
.bar-fill { height: 100%; border-radius: 999rpx; transition: width 0.3s ease; }
.crop-bar { background: linear-gradient(90deg, #38a169, #68d391); }
.region-bar { background: linear-gradient(90deg, #3182ce, #63b3ed); }

.stat-row { display: flex; align-items: center; justify-content: space-between; padding: 20rpx 0; border-top: 1rpx solid #edf2f7; }
.stat-row:first-of-type { margin-top: 12rpx; }
.row-name { display: block; font-weight: 600; }
.row-detail { display: block; margin-top: 5rpx; color: #718096; font-size: 22rpx; }
.row-value { color: #4a5568; font-size: 25rpx; }
.empty-text { display: block; padding: 30rpx 0 10rpx; text-align: center; }
